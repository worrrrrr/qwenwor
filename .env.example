# ============================================================
# Supabase — ตั้งค่าจาก: Supabase Dashboard → Project Settings → API
# คัดลอกไปเป็น .env.local แล้วใส่ค่าจริง
# ============================================================

# Project URL (เช่น https://abcd1234.supabase.co)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon Public Key (เปิดเผยได้ ใช้กับฝั่ง client)
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ⚠️ Service Role Key — ใช้ได้เฉพาะฝั่ง server เท่านั้น (ห้ามรั่วไหลไป client)
# ตั้งค่าใน Vercel dashboard ด้วย (Environment Variables)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
